# Hills of Hems Hub – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage deine Supabase-Werte ein.
#
# WICHTIG (Sicherheit):
#   - Hier gehört NUR der öffentliche "anon"-Key hinein.
#   - Der "service_role"-Key darf NIEMALS ins Frontend / in diese Datei / ins Git.
#   - Beide Werte findest du im Supabase-Dashboard unter:
#       Project Settings -> API
#
# Vite macht nur Variablen mit dem Prefix "VITE_" im Browser verfügbar.

VITE_SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=dein-oeffentlicher-anon-key

# ---------------------------------------------------------------------------
# E-Mail-Benachrichtigungen (Resend) – NUR server-seitig (Function /api/notify)!
# Diese Werte NICHT mit VITE_-Prefix und NICHT im Browser verfügbar machen.
# Im Vercel-Dashboard unter Settings -> Environment Variables setzen
# (für lokale Tests via `vercel dev` in einer .env, die nicht ins Git kommt).
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=dein-geheimer-service-role-key
# RESEND_API_KEY=re_...
# RESEND_FROM=Hills of Hems Hub <hub@deine-domain.de>
# APP_URL=https://deine-app.vercel.app
